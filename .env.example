# Lumen — environment variables
# Add these in Vercel: Project → Settings → Environment Variables
# Only GEMINI_API_KEY is required. The rest are automatic fallbacks.

# Primary — free tier, 1,500 requests/day, no credit card
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback 1 — free tier, very fast (Llama 4 Scout vision)
# https://console.groq.com/keys
GROQ_API_KEY=

# Fallback 2 — paid but cheap (Gemma 4 26B MoE, ~$0.07/1M input tokens)
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Fallback 3 — free tier (Qwen2.5-VL)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
