# Lumen — environment variables
# Add these in Vercel: Project → Settings → Environment Variables
# Configure at least one analysis provider. Keys that are blank are skipped.

# Primary — free tier, 1,500 requests/day, no credit card
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback 1 — Qwen 3.6 vision through Groq
# https://console.groq.com/keys
GROQ_API_KEY=

# Fallback 2 — Gemma 4 multimodal through DeepInfra
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Fallback 3 — Qwen2.5-VL through OpenRouter
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
